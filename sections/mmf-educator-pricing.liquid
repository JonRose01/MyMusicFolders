{%- comment -%}
  MyMusicFolders — Music Educator Pricing page.
  Educator prices come from the "Educator pricing" catalog on the "Music Educators"
  B2B market (every company location). A school gets educator prices once it is set
  up as a company and the director signs in. This page explains that and routes
  directors to apply or sign in. Assigned via templates/page.educator-pricing.json.
{%- endcomment -%}

{%- liquid
  assign is_educator = false
  if customer and customer.b2b?
    assign is_educator = true
  endif
  assign phone_digits = section.settings.phone | remove: '-' | remove: ' ' | remove: '(' | remove: ')' | remove: '.'
  assign apply_url = section.settings.apply_url | default: routes.root_url
-%}

<div class="mmf-edu">
  <section class="mmf-edu__hero">
    <div class="mmf-edu__wrap">
      <p class="mmf-edu__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="mmf-edu__title">{{ section.settings.heading | escape }}</h1>
      <p class="mmf-edu__lede">{{ section.settings.lede | escape }}</p>

      {%- if is_educator -%}
        <div class="mmf-edu__signed-in">
          <span class="mmf-edu__check" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="18" height="18"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg>
          </span>
          <span>
            You're signed in with an educator account{% if customer.current_company %} for <strong>{{ customer.current_company.name | escape }}</strong>{% endif %}.
            Prices across the store already include your discount.
          </span>
        </div>
        <div class="mmf-edu__hero-actions">
          <a class="mmf-edu__btn mmf-edu__btn--gold" href="{{ section.settings.shop_url | default: routes.all_products_collection_url }}">Shop folders</a>
        </div>
      {%- else -%}
        <div class="mmf-edu__hero-stat">
          <span class="mmf-edu__hero-num">{{ section.settings.discount | escape }}</span>
          <span class="mmf-edu__hero-sub">{{ section.settings.discount_sub | escape }}</span>
        </div>
        <div class="mmf-edu__hero-actions">
          <a class="mmf-edu__btn mmf-edu__btn--gold" href="{{ apply_url }}">{{ section.settings.apply_label | escape }}</a>
          {%- if shop.customer_accounts_enabled -%}
            <a class="mmf-edu__btn mmf-edu__btn--ghost" href="{{ routes.account_login_url }}">Educator sign in</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  <section class="mmf-edu__wrap mmf-edu__perks" aria-labelledby="MmfEduPerks">
    <h2 class="mmf-edu__h2" id="MmfEduPerks">What educators get</h2>
    <ul class="mmf-edu__perk-list">
      <li class="mmf-edu__perk">
        <span class="mmf-edu__perk-num">{{ section.settings.discount | escape }}</span>
        <h3>On the whole catalog</h3>
        <p>Choral, band and orchestra folders, accessories and embossing, all at educator pricing.</p>
      </li>
      <li class="mmf-edu__perk">
        <span class="mmf-edu__perk-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path d="M5 11V8a7 7 0 0114 0v3M4 11h16v10H4z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </span>
        <h3>Prices when you sign in</h3>
        <p>No codes to remember. Sign in and every price you see, through to checkout, is your educator price.</p>
      </li>
      <li class="mmf-edu__perk">
        <span class="mmf-edu__perk-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path d="M4 20h16M7 16l9.5-9.5 2 2L9 18H7v-2z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </span>
        <h3>Personalized for your ensemble</h3>
        <p>Emboss names, numbers or your school logo on your folders.</p>
      </li>
    </ul>
  </section>

  {%- unless is_educator -%}
    <section class="mmf-edu__wrap mmf-edu__steps" aria-labelledby="MmfEduSteps">
      <h2 class="mmf-edu__h2" id="MmfEduSteps">How to get educator pricing</h2>
      <ol class="mmf-edu__step-list">
        <li>
          <span class="mmf-edu__step-n">1</span>
          <div><h3>Apply</h3><p>{{ section.settings.step_1 | escape }}</p></div>
        </li>
        <li>
          <span class="mmf-edu__step-n">2</span>
          <div><h3>We set up your school</h3><p>{{ section.settings.step_2 | escape }}</p></div>
        </li>
        <li>
          <span class="mmf-edu__step-n">3</span>
          <div><h3>Sign in and shop</h3><p>{{ section.settings.step_3 | escape }}</p></div>
        </li>
      </ol>
    </section>
  {%- endunless -%}

  {%- if section.settings.educator_details != blank -%}
    <section class="mmf-edu__wrap mmf-edu__details rte">
      {{ section.settings.educator_details }}
    </section>
  {%- endif -%}

  <section class="mmf-edu__cta">
    <div class="mmf-edu__wrap mmf-edu__cta-inner">
      <div>
        <h2 class="mmf-edu__cta-title">{{ section.settings.cta_heading | escape }}</h2>
        <p class="mmf-edu__cta-text">{{ section.settings.cta_text | escape }}</p>
      </div>
      <div class="mmf-edu__cta-actions">
        {%- if section.settings.phone != blank -%}
          <a class="mmf-edu__btn mmf-edu__btn--gold" href="tel:{{ phone_digits }}">Call {{ section.settings.phone | escape }}</a>
        {%- endif -%}
        {%- unless is_educator -%}
          <a class="mmf-edu__btn mmf-edu__btn--ghost" href="{{ apply_url }}">{{ section.settings.apply_label | escape }}</a>
        {%- endunless -%}
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
  .mmf-edu { --mmf-gold: #e4b33a; --mmf-cream: #fbf6e8; --mmf-line: #d9d7d2; --mmf-mute: #5a5650; color: #000; font-family: var(--font-body--family, 'Archivo', sans-serif); }
  .mmf-edu__wrap { width: min(72rem, 100% - 2.5rem); margin-inline: auto; }
  .mmf-edu h1, .mmf-edu h2, .mmf-edu h3 { font-family: var(--font-heading--family, 'Source Serif Pro', Georgia, serif); font-weight: 600; }

  .mmf-edu__hero { padding: clamp(3rem, 7vw, 5.5rem) 0; background: #000; color: #fff; border-bottom: 4px solid var(--mmf-gold); }
  .mmf-edu__eyebrow { margin: 0 0 0.75rem; color: var(--mmf-gold); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .mmf-edu__title { margin: 0; color: #fff; font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1.05; }
  .mmf-edu__lede { max-width: 38rem; margin: 1rem 0 0; color: #d6d4cf; font-size: 1.1rem; line-height: 1.55; }
  .mmf-edu__hero-stat { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; margin-top: 2rem; padding: 0.9rem 1.25rem; border: 1px solid rgba(228,179,58,0.55); }
  .mmf-edu__hero-num { color: var(--mmf-gold); font-family: var(--font-heading--family, 'Source Serif Pro', Georgia, serif); font-size: 1.6rem; font-weight: 600; }
  .mmf-edu__hero-sub { color: #fff; }
  .mmf-edu__hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .mmf-edu__signed-in { display: flex; gap: 0.75rem; align-items: flex-start; max-width: 40rem; margin-top: 2rem; padding: 1rem 1.25rem; background: rgba(228,179,58,0.12); border: 1px solid var(--mmf-gold); color: #fff; line-height: 1.5; }
  .mmf-edu__check { flex: none; display: grid; place-items: center; width: 1.75rem; height: 1.75rem; background: var(--mmf-gold); color: #000; }

  .mmf-edu__perks, .mmf-edu__steps, .mmf-edu__details { padding: clamp(2.5rem, 5vw, 4rem) 0 0; }
  .mmf-edu__h2 { margin: 0; font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.15; }
  .mmf-edu__perk-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.75rem; margin: 1.75rem 0 0; padding: 0; list-style: none; }
  .mmf-edu__perk { padding: 1.75rem 1.5rem; border: 1px solid var(--mmf-line); background: #fff; }
  .mmf-edu__perk:first-child { background: #000; border-color: #000; color: #fff; }
  .mmf-edu__perk-num { display: block; color: var(--mmf-gold); font-family: var(--font-heading--family, 'Source Serif Pro', Georgia, serif); font-size: 2.75rem; font-weight: 600; line-height: 1; }
  .mmf-edu__perk-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; background: var(--mmf-cream); border: 1px solid var(--mmf-gold); }
  .mmf-edu__perk h3 { margin: 1rem 0 0.4rem; font-size: 1.2rem; }
  .mmf-edu__perk:first-child h3 { color: #fff; }
  .mmf-edu__perk p { margin: 0; color: var(--mmf-mute); line-height: 1.5; }
  .mmf-edu__perk:first-child p { color: #bdbab3; }

  .mmf-edu__step-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .mmf-edu__step-list li { display: flex; gap: 1rem; }
  .mmf-edu__step-n { flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; background: #000; color: var(--mmf-gold); font-weight: 700; }
  .mmf-edu__step-list h3 { margin: 0.2rem 0 0.3rem; font-size: 1.15rem; }
  .mmf-edu__step-list p { margin: 0; color: var(--mmf-mute); line-height: 1.5; }

  .mmf-edu__cta { margin-top: clamp(3rem, 6vw, 4.5rem); padding: clamp(2.5rem, 5vw, 3.5rem) 0; background: #000; color: #fff; }
  .mmf-edu__cta-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; }
  .mmf-edu__cta-title { margin: 0; color: #fff; font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .mmf-edu__cta-text { margin: 0.5rem 0 0; color: #d6d4cf; max-width: 34rem; }
  .mmf-edu__cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .mmf-edu__btn { display: inline-block; padding: 0.85rem 1.4rem; font-weight: 700; text-decoration: none; border: 1px solid var(--mmf-gold); }
  .mmf-edu__btn--gold { background: var(--mmf-gold); color: #000; }
  .mmf-edu__btn--gold:hover { background: #f0c75a; }
  .mmf-edu__btn--ghost { color: #fff; }
  .mmf-edu__btn--ghost:hover { color: var(--mmf-gold); }
{% endstylesheet %}

{% schema %}
{
  "name": "Educator pricing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For directors & schools" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Music Educator Pricing" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Music education professionals can apply for an educator account and get a discount on their school's orders." },
    { "type": "text", "id": "discount", "label": "Discount (keep in sync with the Educator pricing catalog)", "default": "10% off" },
    { "type": "text", "id": "discount_sub", "label": "Discount line", "default": "every order with an educator account" },
    { "type": "header", "content": "Apply" },
    { "type": "text", "id": "apply_label", "label": "Apply button label", "default": "Apply for an educator account" },
    { "type": "url", "id": "apply_url", "label": "Apply button link" },
    { "type": "text", "id": "step_1", "label": "Step 1", "default": "Send us your name, school and role. We'll confirm you're a music educator." },
    { "type": "text", "id": "step_2", "label": "Step 2", "default": "We create an account for your school and email you an invitation." },
    { "type": "text", "id": "step_3", "label": "Step 3", "default": "Accept the invite and sign in. Educator prices show throughout the store and at checkout." },
    { "type": "richtext", "id": "educator_details", "label": "Program details (optional)", "info": "Eligibility, purchase orders, etc. Shown only when filled in." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Questions about a school order?" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Talk to our team about outfitting your ensemble, embossing and large orders." },
    { "type": "text", "id": "phone", "label": "Phone", "default": "888-266-0731" },
    { "type": "url", "id": "shop_url", "label": "Shop link (signed-in educators)" }
  ],
  "presets": [{ "name": "Educator pricing" }]
}
{% endschema %}
