{%- comment -%}
  MyMusicFolders bulk pricing table.
  Shows the quantity discount tiers on products carrying the tag in the block
  settings. The discounts themselves are Shopify automatic discounts ("Bulk
  pricing: ..."), limited to regular shoppers, so signed-in educator (B2B)
  accounts never see this table. Keep the tiers here in step with those discounts.
{%- endcomment -%}
{%- liquid
  assign product = closest.product
  assign enabled = false
  if block.settings.tag != blank and product.tags contains block.settings.tag
    assign enabled = true
  endif
  if customer and customer.b2b?
    assign enabled = false
  endif
  assign rows = block.settings.tiers | newline_to_br | split: '<br />'
-%}

{%- if enabled and rows.size > 0 -%}
<div class="mmf-bulk spacing-style" style="{% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <table class="mmf-bulk__table">
    <caption class="mmf-bulk__title">{{ block.settings.heading | escape }}</caption>
    <thead>
      <tr>
        <th scope="col">{{ block.settings.col_quantity | escape }}</th>
        <th scope="col">{{ block.settings.col_saving | escape }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for row in rows -%}
        {%- assign parts = row | strip | split: '|' -%}
        {%- if parts.size == 2 -%}
          <tr>
            <td>{{ parts[0] | strip | escape }}</td>
            <td>{{ parts[1] | strip | escape }}</td>
          </tr>
        {%- endif -%}
      {%- endfor -%}
    </tbody>
  </table>
  {%- if block.settings.note != blank -%}
    <p class="mmf-bulk__note">{{ block.settings.note | escape }}</p>
  {%- endif -%}
</div>
{%- endif -%}

{%- if enabled and rows.size > 0 -%}
{% style %}
  .mmf-bulk { display: block; width: 100%; }
  .mmf-bulk__table { width: 100%; max-width: 26rem; border-collapse: collapse; font-size: 0.9em; margin: 0; }
  .mmf-bulk__title {
    caption-side: top;
    text-align: left;
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 var(--padding-sm);
    padding: 0 0 var(--padding-sm);
  }
  .mmf-bulk__table th, .mmf-bulk__table td {
    text-align: left;
    padding: .4rem .75rem;
    border: 1px solid var(--color-border, #D9D7D2);
  }
  .mmf-bulk__table th { font-weight: 600; background: #FBF6E8; }
  .mmf-bulk__table td:last-child, .mmf-bulk__table th:last-child { white-space: nowrap; }
  .mmf-bulk__note { font-size: 0.85em; opacity: .75; margin: var(--padding-sm) 0 0; }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Bulk pricing table",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Only shows on products with the tag below, and never to signed-in educator accounts. Keep the tiers in step with the Bulk pricing discounts in Shopify admin."
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Product tag",
      "default": "bulk-pricing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy more, save more"
    },
    {
      "type": "text",
      "id": "col_quantity",
      "label": "Quantity column heading",
      "default": "Folders in your order"
    },
    {
      "type": "text",
      "id": "col_saving",
      "label": "Saving column heading",
      "default": "You save"
    },
    {
      "type": "textarea",
      "id": "tiers",
      "label": "Tiers",
      "info": "One tier per line, written as quantity | saving.",
      "default": "20 to 39 | 2% off\n40 to 59 | 4% off\n60 to 79 | 6% off\n80 to 99 | 8% off\n100 or more | 10% off"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note under the table",
      "default": "Mix and match any folders that show this table to reach a tier. Your discount is applied automatically."
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Bulk pricing table", "category": "Product" }]
}
{% endschema %}
